// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model PhpExtension {
  id       Int                      @id @default(autoincrement())
  name     String                   @unique
  type     String                   // "bundled" | "pecl" | "custom" | "vendor"
  versions PhpVersionSupport[]
  specials SpecialRequirement[]
}

model PhpVersionSupport {
  id          Int          @id @default(autoincrement())
  extensionId Int
  phpVersion  String       // e.g. "8.4", "8.3", "7.4"
  extension   PhpExtension @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@unique([extensionId, phpVersion])
}

model SpecialRequirement {
  id          Int          @id @default(autoincrement())
  extensionId Int
  requirement String       // e.g. "zts", "!jessie", "!alpine"
  extension   PhpExtension @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@unique([extensionId, requirement])
}
