// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model PhpExtension {
  id       Int                      @id @default(autoincrement())
  name     String                   @unique
  type     String                   // "bundled" | "pecl" | "custom" | "vendor"
  versions PhpVersionSupport[]
  specials SpecialRequirement[]
  websites WebsitePhpExtension[]
}

model PhpVersionSupport {
  id          Int          @id @default(autoincrement())
  extensionId Int
  phpVersion  String       // e.g. "8.4", "8.3", "7.4"
  extension   PhpExtension @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@unique([extensionId, phpVersion])
}

model SpecialRequirement {
  id          Int          @id @default(autoincrement())
  extensionId Int
  requirement String       // e.g. "zts", "!jessie", "!alpine"
  extension   PhpExtension @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@unique([extensionId, requirement])
}

model Website {
  id           Int                      @id @default(autoincrement())
  name         String
  domain       String                   @unique
  port         Int                      @default(80)
  documentRoot String
  phpVersion   String                   // e.g. "8.4", "8.3", "7.4"
  sslEnabled   Boolean                  @default(false)
  status       String                   @default("stopped") // "running" | "stopped" | "error"
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  extensions   WebsitePhpExtension[]
}

model WebsitePhpExtension {
  id          Int          @id @default(autoincrement())
  websiteId   Int
  extensionId Int
  enabled     Boolean      @default(true)
  website     Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  extension   PhpExtension @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@unique([websiteId, extensionId])
}
