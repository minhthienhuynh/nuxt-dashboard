# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Plan-comparison cache (S3-compatible object storage, e.g. Oracle Object Storage)
# Doc bang NUXT_PLAN_COMPARISON_S3_* (uu tien) hoac S3_* (fallback, dang dung tren Dokploy).
# Chi can dien 1 trong 2 nhom; de trong ca 2 thi server chay o che do khong cache (MISS).
NUXT_PLAN_COMPARISON_S3_ENDPOINT=
NUXT_PLAN_COMPARISON_S3_ACCESS_KEY_ID=
NUXT_PLAN_COMPARISON_S3_SECRET_ACCESS_KEY=
NUXT_PLAN_COMPARISON_S3_REGION=
NUXT_PLAN_COMPARISON_S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
